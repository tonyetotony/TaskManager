@url = http://localhost:5139

POST {{url}}/api/users/create
Accept: application/json
Content-Type: application/json

{
  "firstName": "Vadim",
  "lastName": "Zaviyalov",
  "email": "admin@example.com",
  "password": "123",
  "status": 0,
  "phone": "+79991231122"
}


###

GET {{url}}/api/users
Authorization: Bearer 
Accept: application/json
Content-Type: application/json

###

DELETE {{url}}/api/users/delete/20
Accept: application/json
Content-Type: application/json

###

PATCH {{url}}/api/users/update/12
Accept: application/json
Content-Type: application/json

{
  "firstName": "anton",
  "lastName": "pasichnichenko",
  "email": "admin",
  "password": "qwerty123",
  "status": 2,
  "phone": "+79991234567"
}


