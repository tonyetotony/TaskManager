<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Brush x:Key="commonBlueColor">#0696d7</Brush>
    <Brush x:Key="commonRedColor">Red</Brush>
    <Brush x:Key="commonGreyColor">Gray</Brush>
    <Brush x:Key="commonGreenColor">Green</Brush>
    <FontStyle x:Key="commonFontStyle">Normal</FontStyle>
    
    <Style TargetType="TextBox" x:Key="commonTBox">
        <Setter Property="Height" Value="38"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="FontStyle" Value="{StaticResource commonFontStyle}"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0,3"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="Padding" Value="10,6"></Setter>
        <Setter Property="Foreground" Value="#2C3E50"></Setter>
        <Setter Property="CaretBrush" Value="#0696d7"></Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="8"></Setter>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#0696d7"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>
    
    <Style TargetType="TextBox" x:Key="multilineTBox" BasedOn="{StaticResource commonTBox}">
        <Setter Property="Height" Value="Auto"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="MinHeight" Value="60"></Setter>
    </Style>
    
    <Style TargetType="PasswordBox" x:Key="commonPBox">
        <Setter Property="Height" Value="38"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="FontStyle" Value="{StaticResource commonFontStyle}"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0,3"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="Padding" Value="10,6"></Setter>
        <Setter Property="Foreground" Value="#2C3E50"></Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="8"></Setter>
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#0696d7"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>
    
    <Style TargetType="Button" x:Key="commonBtn">
        <Setter Property="Background" Value="{StaticResource commonBlueColor}"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource commonBlueColor}"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="Margin" Value="5"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Height" Value="36"></Setter>
        <Setter Property="Padding" Value="15,8"></Setter>
        <Setter Property="FontWeight" Value="SemiBold"></Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="8"></Setter>
            </Style>
            <Style TargetType="Button">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#0582BA"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#046A9A"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>
    
    <Style TargetType="Button" x:Key="commonBtnRed" BasedOn="{StaticResource commonBtn}">
        <Setter Property="Background" Value="{StaticResource commonRedColor}"></Setter>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="sharedTBlock">
        <Setter Property="FontStyle" Value="{StaticResource commonFontStyle}"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="commonTBlock" BasedOn="{StaticResource sharedTBlock}">
        <Setter Property="FontSize" Value="14"></Setter>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="headerTBlock" BasedOn="{StaticResource sharedTBlock}">
        <Setter Property="FontSize" Value="20"></Setter>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="fieldLabel">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="SemiBold"></Setter>
        <Setter Property="Foreground" Value="#34495E"></Setter>
        <Setter Property="Margin" Value="0,0,0,6"></Setter>
    </Style>
    
    <Style TargetType="GridSplitter" x:Key="commonSplitter">
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource commonGreyColor}"></Setter>
        <Setter Property="Margin" Value="2"></Setter>
        <Setter Property="Background" Value="#ECF0F1"/>
    </Style>
    
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="#ECF0F1"/>
        <Setter Property="Width" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style TargetType="Border" x:Key="commonBorder">
        <Setter Property="BorderBrush" Value="{StaticResource commonGreyColor}"></Setter>
    </Style> 
    
    <Style TargetType="Border" x:Key="commonPanelBorder">
        <Setter Property="BorderBrush" Value="{StaticResource commonBlueColor}"></Setter>
        <Setter Property="Margin" Value="10"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="CornerRadius" Value="3"></Setter>
        <Setter Property="Width" Value="200"></Setter>
    </Style>
    
    <Style TargetType="Border" x:Key="projectPanelBorder" BasedOn="{StaticResource commonPanelBorder}">
        <Setter Property="Background" Value="GhostWhite"></Setter>
    </Style> 
    
    <Style TargetType="Border" x:Key="userBorderPanel" BasedOn="{StaticResource commonPanelBorder}">
        <Setter Property="Width" Value="Auto"/>
    </Style>
    
    <Style TargetType="Border" x:Key="deskPanelBorder" BasedOn="{StaticResource commonPanelBorder}">
        <Setter Property="Background" Value="#edfff2"></Setter>
    </Style>
    
    <Style TargetType="Border" x:Key="taskPanelBorder" BasedOn="{StaticResource commonPanelBorder}">
        <Setter Property="Background" Value="White"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Margin" Value="5"></Setter>
        <Setter Property="Padding" Value="0"></Setter>
        <Setter Property="BorderBrush" Value="#E0E0E0"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="CornerRadius" Value="12"></Setter>
    </Style>
    
    <Style TargetType="CheckBox" x:Key="commonChBox">
        <Setter Property="BorderBrush" Value="{StaticResource commonGreenColor}"/>
    </Style>
    
    <Style TargetType="ItemsControl" x:Key="taskColumnPanel">
        <Setter Property="Background" Value="#F8F9FA"></Setter>
        <Setter Property="Margin" Value="5"></Setter>
        <Setter Property="BorderBrush" Value="#E0E0E0"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12"></Setter>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#0696d7"></Setter>
                <Setter Property="Background" Value="#E8F4F8"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>