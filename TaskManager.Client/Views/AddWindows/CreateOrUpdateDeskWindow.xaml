<Window x:Class="TaskManager.Client.Views.AddWindows.CreateOrUpdateDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TaskManager.Client.Views.AddWindows"
        mc:Ignorable="d"
        Title="Доска" 
        Height="650" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    
    <!-- Тень для карточки -->
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Window.Resources>
    
    <Border Background="White" 
            CornerRadius="12" 
            Effect="{StaticResource CardShadow}"
            Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <Border Width="40" Height="40" Background="#0696d7" CornerRadius="20" Margin="0,0,12,0">
                    <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Создание доски" 
                          FontSize="22" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
            </StackPanel>
            
            <!-- Форма -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Название -->
                    <Label Content="📌 Название"/>
                    <TextBox Text="{Binding SelectedDesk.Model.Name}" 
                             Style="{StaticResource commonTBox}" 
                             Margin="0,0,0,15"/>
                    
                    <!-- Описание -->
                    <Label Content="📄 Описание" />
                    <TextBox Text="{Binding SelectedDesk.Model.Description}" 
                             Style="{StaticResource multilineTBox}" 
                             Margin="0,0,0,15"/>
                    
                    <!-- Колонки -->
                    <Label Content="📊 Колонки"/>
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding ColumnsForNewDesk}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBox Text="{Binding Value}" 
                                                         Width="180" 
                                                         Style="{StaticResource commonTBox}"/>
                                                <Button Content="✕" 
                                                        Command="{Binding Path=DataContext.RemoveColumnItemCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource commonBtn}"
                                                        Width="30"
                                                        Height="30"
                                                        Padding="0"
                                                        Margin="5,0,0,0"
                                                        Background="#E74C3C"
                                                        BorderBrush="#E74C3C"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="➕ Добавить колонку" 
                                    Command="{Binding AddNewColumnItemCommand}" 
                                    Style="{StaticResource commonBtn}"
                                    Height="36"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Кнопки -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="Отмена" 
                        Click="CancelButton_Click"
                        Style="{StaticResource commonBtn}"
                        Width="100"
                        Background="#95A5A6"
                        BorderBrush="#95A5A6"/>
                <Button Content="Удалить" 
                        Command="{Binding DeleteDeskCommand}"
                        Width="100"
                        Background="#E74C3C"
                        BorderBrush="#E74C3C"
                        Visibility="{Binding DeleteButtonVisibility}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TypeActionWithDesk}" Value="Create">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Сохранить" 
                        Command="{Binding CreateOrUpdateDeskCommand}"
                        Style="{StaticResource commonBtn}"
                        Width="120"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
