<Window x:Class="TaskManager.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Client.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        MinHeight="200" MinWidth="300"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" MinWidth="50" MaxWidth="150"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="0" Style="{StaticResource commonSplitter}"></GridSplitter>
        <Grid Grid.Column="0">
            <ItemsControl ItemsSource="{Binding NavButtons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Value}" 
                            Style="{StaticResource commonBtn}">
                            <TextBlock Text="{Binding Key}" Style="{StaticResource commonTBlock}"></TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,2" Style="{StaticResource commonBorder}"></Border>
            <TextBlock Text="{Binding SelectedPageName}" Style="{StaticResource headerTBlock}"></TextBlock>
            <Frame Grid.Row="1" NavigationUIVisibility="Hidden" Content="{Binding SelectedPage }"></Frame>
        </Grid>
    </Grid>
</Window>
