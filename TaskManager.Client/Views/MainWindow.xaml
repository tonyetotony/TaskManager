<Window x:Class="TaskManager.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Client.Views"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        Title="TaskManager" 
        Height="650" 
        Width="1300"
        MinHeight="400" 
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
        
        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource commonBtn}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0582BA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="150" MaxWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Левая панель навигации -->
        <Border Grid.Column="0" 
                Background="White" 
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Логотип -->
                <Border Grid.Row="0" 
                        Background="#0696d7" 
                        Padding="15,20">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="TaskManager" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Кнопки навигации -->
                <ItemsControl Grid.Row="1" 
                             ItemsSource="{Binding NavButtons}"
                             Margin="10,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Value}" 
                                   Style="{StaticResource NavButtonStyle}">
                                <TextBlock Text="{Binding Key}" 
                                          FontSize="14"
                                          Foreground="White"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Кнопка выхода -->
                <Button Grid.Row="2" 
                       Content="Выход" 
                       Command="{Binding LogoutCommand}"
                       Style="{StaticResource commonBtnRed}"
                       Height="40"
                       Margin="10,10"
                       FontWeight="SemiBold"/>
            </Grid>
        </Border>
        
        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" 
                     Width="5"
                     HorizontalAlignment="Center"
                     Background="#ECF0F1"/>
        
        <!-- Основной контент -->
        <Border Grid.Column="2" 
                Background="White"
                CornerRadius="12"
                Margin="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок страницы -->
                <Border Grid.Row="0" 
                       Background="#F8F9FA"
                       BorderThickness="0,0,0,1"
                       BorderBrush="#ECF0F1"
                       Padding="20,0">
                    <TextBlock Text="{Binding SelectedPageName}" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              Foreground="#2C3E50"
                              VerticalAlignment="Center"/>
                </Border>
                
                <!-- Контент страницы -->
                <Frame Grid.Row="1" 
                      NavigationUIVisibility="Hidden" 
                      Content="{Binding SelectedPage }"
                      Padding="20"/>
            </Grid>
        </Border>
    </Grid>
</Window>
