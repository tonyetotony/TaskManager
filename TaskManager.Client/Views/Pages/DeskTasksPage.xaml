<Page x:Class="TaskManager.Client.Views.Pages.DeskTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      mc:Ignorable="d"
      Title="DeskTasksPage"
      d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Кнопка добавления задачи -->
        <Border Grid.Row="0" 
                Background="#F8F9FA" 
                BorderBrush="#ECF0F1"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <Button Content="➕ Новая задача" 
                    Command="{Binding OpenNewTaskCommand}"
                    Height="42"
                    FontSize="14"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentUser.Status}" Value="User">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
        
        <!-- Сетка задач на всё оставшееся пространство -->
        <Grid Grid.Row="1" x:Name="tasksGrid" Margin="15"/>
    </Grid>
</Page>
