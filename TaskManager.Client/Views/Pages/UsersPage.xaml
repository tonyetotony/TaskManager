<Page x:Class="TaskManager.Client.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      xmlns:models="clr-namespace:TaskManager.Common.Models"
      mc:Ignorable="d"
      Title="Пользователи"
      d:DesignHeight="600" d:DesignWidth="800">
    <Page.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <TextBlock Text="👥" FontSize="28" Margin="0,0,10,0"/>
                <TextBlock Text="Пользователи" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
            </StackPanel>
            
            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <Button Content="➕ Добавить пользователя" 
                       Style="{StaticResource commonBtn}"
                       Height="45"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,15,0"
                       Command="{Binding OpenNewUserCommand}"/>
                
                <Button Content="📁 Импорт из Excel" 
                       Style="{StaticResource commonBtn}"
                       Height="45"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Command="{Binding OpenSelectUsersFromExcelCommand}"/>
            </StackPanel>
            
            <!-- Карточки пользователей -->
            <ItemsControl ItemsSource="{Binding AllUsers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                               CornerRadius="12" 
                               Padding="20"
                               Effect="{StaticResource CardShadow}"
                               Margin="0,0,20,20"
                               Width="300">
                            <StackPanel>
                                <!-- Аватар -->
                                <Border Width="60" Height="60" Background="#0696d7" CornerRadius="30" Margin="0,0,0,15">
                                    <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                
                                <!-- Имя и фамилия -->
                                <TextBlock FontSize="16" 
                                          FontWeight="Bold" 
                                          Foreground="#2C3E50"
                                          Margin="0,0,0,5">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                
                                <TextBlock Text="{Binding Email}" 
                                          FontSize="13" 
                                          Foreground="#7F8C8D"
                                          Margin="0,0,0,10"/>
                                
                                <!-- Роль -->
                                <Border Background="#0696d7" 
                                       CornerRadius="12" 
                                       Padding="12,6"
                                       Margin="0,0,0,15"
                                       HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" 
                                              FontSize="12" 
                                              FontWeight="SemiBold" 
                                              Foreground="White"/>
                                </Border>
                                
                                <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                
                                <!-- Контакты -->
                                <StackPanel>
                                    <!-- Телефон -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="📱" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7F8C8D"/>
                                        </Border>
                                        <TextBlock Text="{Binding Phone}" 
                                                  FontSize="12" 
                                                  Foreground="#7F8C8D"
                                                  Margin="4,0,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Дата регистрации -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="📅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7F8C8D"/>
                                        </Border>
                                        <TextBlock Text="{Binding RegistrationDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                                  FontSize="12" 
                                                  Foreground="#7F8C8D"
                                                  Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                
                                <!-- Кнопки действий -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️" 
                                           Style="{StaticResource commonBtn}"
                                           Width="35"
                                           Height="35"
                                           Padding="0"
                                           FontSize="16"
                                           Margin="0,0,8,0"
                                           Command="{Binding DataContext.OpenUpdateUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"/>
                                    
                                    <Button Content="🗑️" 
                                           Style="{StaticResource commonBtnRed}"
                                           Width="35"
                                           Height="35"
                                           Padding="0"
                                           FontSize="16"
                                           Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
