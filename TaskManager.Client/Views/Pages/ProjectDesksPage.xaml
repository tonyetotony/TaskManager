<Page x:Class="TaskManager.Client.Views.Pages.ProjectDesksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      xmlns:models="clr-namespace:TaskManager.Common.Models"
      mc:Ignorable="d"
      Title="Доски проекта"
      d:DesignHeight="600" d:DesignWidth="800">
    <Page.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <TextBlock Text="📋" FontSize="28" Margin="0,0,10,0"/>
                <TextBlock Text="Доски проекта" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
            </StackPanel>
            
            <!-- Кнопка создания доски -->
            <Button Content="➕ Создать доску" 
                   Height="45"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,25"
                   HorizontalAlignment="Left"
                   Command="{Binding OpenNewDeskCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentUser.Status}" Value="User">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <!-- Карточки досок -->
            <ItemsControl ItemsSource="{Binding ProjectDesks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                               CornerRadius="12" 
                               Padding="20"
                               Effect="{StaticResource CardShadow}"
                               Margin="0,0,20,20"
                               Width="280">
                            <StackPanel>
                                <!-- Иконка доски -->
                                <Border Width="50" 
                                       Height="50" 
                                       Background="#0696d7" 
                                       CornerRadius="25"
                                       Margin="0,0,0,15">
                                    <TextBlock Text="📋" 
                                              FontSize="24" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Foreground="White"/>
                                </Border>
                                
                                <!-- Название доски -->
                                <TextBlock Text="{Binding Model.Name}" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Foreground="#2C3E50"
                                          Margin="0,0,0,8"/>
                                
                                <!-- Описание -->
                                <TextBlock Text="{Binding Model.Description}" 
                                          FontSize="13" 
                                          Foreground="#7F8C8D"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"
                                          MaxHeight="60"/>
                                
                                <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                
                                <!-- Количество задач -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                        <TextBlock Text="📝" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Задач: " 
                                              FontSize="12" 
                                              Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding Model.TasksIds.Count}" 
                                              FontSize="12" 
                                              FontWeight="SemiBold"
                                              Foreground="#2C3E50"/>
                                </StackPanel>
                                
                                <!-- Дата создания -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                        <TextBlock Text="📅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Model.CreationDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                              FontSize="12" 
                                              Foreground="#7F8C8D"/>
                                </StackPanel>
                                
                                <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                
                                <!-- Кнопки действий -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📋" 
                                           Style="{StaticResource commonBtn}"
                                           Width="35"
                                           Height="35"
                                           Padding="0"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           Command="{Binding DataContext.OpenDeskTasksPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Model.Id}"/>
                                    
                                    <Button Content="✏️" 
                                           Width="35"
                                           Height="35"
                                           Padding="0"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           Command="{Binding DataContext.OpenUpdateDeskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Model.Id}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CurrentUser.Status, RelativeSource={RelativeSource AncestorType=Page}}" Value="User">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Content="🗑️" 
                                           Width="35"
                                           Height="35"
                                           Padding="0"
                                           FontSize="14"
                                           Command="{Binding DataContext.DeleteDeskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Model.Id}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource commonBtnRed}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CurrentUser.Status, RelativeSource={RelativeSource AncestorType=Page}}" Value="User">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
