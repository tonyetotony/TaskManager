<Page x:Class="TaskManager.Client.Views.Pages.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      xmlns:models="clr-namespace:TaskManager.Common.Models"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:dat="clr-namespace:System.Windows.Data"
      mc:Ignorable="d"
      Title="Мои проекты"
      d:DesignHeight="600" d:DesignWidth="1000">
    <Page.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        
        <!-- Левая панель - список проектов -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- Заголовок -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="📁" FontSize="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Мои проекты" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Foreground="#2C3E50"/>
                </StackPanel>
                
                <!-- Кнопка создания проекта -->
                <Button Content="➕ Создать проект" 
                       
                       Height="45"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,25"
                       HorizontalAlignment="Left"
                       Command="{Binding OpenNewProjectCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentUser.Status}" Value="User">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Карточки проектов -->
                <ItemsControl ItemsSource="{Binding UserProjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                   CornerRadius="12" 
                                   Padding="20"
                                   Effect="{StaticResource CardShadow}"
                                   Margin="0,0,20,20"
                                   Width="280">
                                <StackPanel>
                                    <!-- Иконка проекта -->
                                    <Border Width="50" 
                                           Height="50" 
                                           Background="#0696d7" 
                                           CornerRadius="25"
                                           Margin="0,0,0,15">
                                        <TextBlock Text="📁" 
                                                  FontSize="24" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Название проекта -->
                                    <TextBlock Text="{Binding Model.Name}" 
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Foreground="#2C3E50"
                                              Margin="0,0,0,8"/>
                                    
                                    <!-- Описание -->
                                    <TextBlock Text="{Binding Model.Description}" 
                                              FontSize="13" 
                                              Foreground="#7F8C8D"
                                              TextWrapping="Wrap"
                                              Margin="0,0,0,15"
                                              MaxHeight="60"/>
                                    
                                    <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                    
                                    <!-- Статус проекта -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="📊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Model.Status}" 
                                                  FontSize="12" 
                                                  Foreground="#7F8C8D"/>
                                    </StackPanel>
                                    
                                    <!-- Кнопки действий -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📋" 
                                               Style="{StaticResource commonBtn}"
                                               Width="35"
                                               Height="35"
                                               Padding="0"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               Command="{Binding DataContext.ShowProjectInfoCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Model.Id}"/>
                                        
                                        <Button Content="✏️" 
                                               
                                               Width="35"
                                               Height="35"
                                               Padding="0"
                                               FontSize="14"
                                               Command="{Binding DataContext.OpenUpdateProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Model.Id}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.CurrentUser.Status, RelativeSource={RelativeSource AncestorType=Page}}" Value="User">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Правая панель - детали проекта -->
        <Border Grid.Column="1" 
                Background="White"
                BorderThickness="1,0,0,0"
                BorderBrush="#ECF0F1"
                Margin="10,10,10,10">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject.Model}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок -->
                <Border Grid.Row="0" 
                       Background="#F8F9FA"
                       BorderThickness="0,0,0,1"
                       BorderBrush="#ECF0F1"
                       Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="📁" FontSize="20" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SelectedProject.Model.Name}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>
                
                <!-- Контент -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- Описание -->
                        <TextBlock Text="Описание" 
                                  FontSize="12" 
                                  Foreground="#7F8C8D" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SelectedProject.Model.Description}" 
                                  FontSize="14" 
                                  Foreground="#2C3E50"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,20"/>
                        
                        <Border Height="1" Background="#ECF0F1" Margin="0,0,0,20"/>
                        
                        <!-- Статус -->
                        <TextBlock Text="Статус" 
                                  FontSize="12" 
                                  Foreground="#7F8C8D" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,5"/>
                        <Border Background="#E8F4F8" 
                               CornerRadius="8" 
                               Padding="10,8"
                               Margin="0,0,0,20">
                            <TextBlock Text="{Binding SelectedProject.Model.Status}" 
                                      FontSize="14" 
                                      Foreground="#0696d7"
                                      FontWeight="SemiBold"/>
                        </Border>
                        
                        <Border Height="1" Background="#ECF0F1" Margin="0,0,0,20"/>
                        
                        <!-- Кнопки действий -->
                        <Button Content="➕ Добавить пользователей" 
                               
                               Height="40"
                               Margin="0,0,0,10"
                               Command="{Binding OpenNewUsersToProjectCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentUser.Status}" Value="User">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Content="📋 Доски проекта" 
                               Style="{StaticResource commonBtn}"
                               Height="40"
                               Margin="0,0,0,20"
                               Command="{Binding OpenProjectDesksPageCommand}"/>
                        
                        <Border Height="1" Background="#ECF0F1" Margin="0,0,0,20"/>
                        
                        <!-- Пользователи проекта -->
                        <TextBlock Text="Пользователи проекта" 
                                  FontSize="12" 
                                  Foreground="#7F8C8D" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        
                        <ListBox ItemsSource="{Binding ProjectUsers}"
                                BorderThickness="0"
                                Background="#F8F9FA">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                           CornerRadius="8" 
                                           Padding="10"
                                           Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Аватар -->
                                            <Border Width="30" Height="30" Background="#0696d7" CornerRadius="15" Margin="0,0,10,0">
                                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                            </Border>
                                            
                                            <!-- Информация -->
                                            <StackPanel>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="LastName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Email}" 
                                                          FontSize="11" 
                                                          Foreground="#7F8C8D"/>
                                            </StackPanel>
                                            
                                            <!-- Кнопка удаления -->
                                            <Button Content="✕" 
                                                   Width="25"
                                                   Height="25"
                                                   Padding="0"
                                                   Margin="10,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   
                                                   Command="{Binding DataContext.RemoveUserFromProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource commonBtnRed}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CurrentUser.Status, RelativeSource={RelativeSource AncestorType=Page}}" Value="User">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
