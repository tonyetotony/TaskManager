<Page x:Class="TaskManager.Client.Views.Pages.UserInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      xmlns:models="clr-namespace:TaskManager.Common.Models"
      mc:Ignorable="d"
      Title="Мой профиль"
      d:DesignHeight="600" d:DesignWidth="800">
    <Page.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Заголовок -->
            <TextBlock Text="👤 Мой профиль" 
                      FontSize="28" 
                      FontWeight="Bold" 
                      Foreground="#2C3E50"
                      Margin="0,0,0,30"/>
            
            <!-- Карточка профиля -->
            <Border Background="White" 
                   CornerRadius="12" 
                   Padding="30"
                   Effect="{StaticResource CardShadow}"
                   Margin="0,0,0,20">
                <StackPanel>
                    <!-- Аватар и основная информация -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <!-- Аватар -->
                        <Border Width="100" 
                               Height="100" 
                               Background="#0696d7" 
                               CornerRadius="50"
                               Margin="0,0,25,0">
                            <TextBlock Text="👤" 
                                      FontSize="50" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      Foreground="White"/>
                        </Border>
                        
                        <!-- Имя и роль -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FirstName}" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding CurrentUser.LastName}" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50"
                                      Margin="0,2,0,0"/>
                            <Border Background="#0696d7" 
                                   CornerRadius="12" 
                                   Padding="10,5"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CurrentUser.Status}" 
                                          FontSize="12" 
                                          FontWeight="SemiBold" 
                                          Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Height="1" Background="#ECF0F1" Margin="0,0,0,20"/>
                    
                    <!-- Контактная информация -->
                    <StackPanel>
                        <!-- Email -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Width="40" Height="40" Background="#E8F4F8" CornerRadius="8" Margin="0,0,15,0">
                                <TextBlock Text="📧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Email" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUser.Email}" FontSize="14" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Телефон -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Width="40" Height="40" Background="#E8F4F8" CornerRadius="8" Margin="0,0,15,0">
                                <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Телефон" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUser.Phone}" FontSize="14" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Дата регистрации -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Width="40" Height="40" Background="#E8F4F8" CornerRadius="8" Margin="0,0,15,0">
                                <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Дата регистрации" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUser.RegistrationDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="14" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Последний вход -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#E8F4F8" CornerRadius="8" Margin="0,0,15,0">
                                <TextBlock Text="🕐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Последний вход" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentUser.LastLoginDate, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue='Не указано', FallbackValue='Не указано'}" FontSize="14" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✏️ Редактировать профиль" 
                       Style="{StaticResource commonBtn}"
                       Height="40"
                       Margin="0,0,10,0"/>
                <Button Content="🔒 Сменить пароль" 
                       Style="{StaticResource commonBtn}"
                       Height="40"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
