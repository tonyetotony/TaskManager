<Page x:Class="TaskManager.Client.Views.Pages.UserTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      xmlns:models="clr-namespace:TaskManager.Common.Models"
      mc:Ignorable="d"
      Title="Мои задачи"
      d:DesignHeight="600" d:DesignWidth="800">
    <Page.Resources>
        <!-- Тень для карточки -->
        <DropShadowEffect x:Key="CardShadow" 
                         Direction="270" 
                         ShadowDepth="5" 
                         BlurRadius="15" 
                         Opacity="0.2"/>
    </Page.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <TextBlock Text="📝" FontSize="28" Margin="0,0,10,0"/>
                <TextBlock Text="Мои задачи" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
            </StackPanel>
            
            <!-- Если задач нет -->
            <StackPanel Visibility="Collapsed" >
                <Border Background="#F8F9FA" 
                       CornerRadius="12" 
                       Padding="40"
                       BorderBrush="#ECF0F1"
                       BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📭" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="У вас пока нет задач" 
                                  FontSize="18" 
                                  Foreground="#7F8C8D"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Задачи будут появляться здесь когда вам назначат задачи" 
                                  FontSize="14" 
                                  Foreground="#BDC3C7"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Карточки задач -->
            <ItemsControl ItemsSource="{Binding AllTasks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                               CornerRadius="12" 
                               Padding="20"
                               Effect="{StaticResource CardShadow}"
                               Margin="0,0,20,20"
                               Width="300">
                            <StackPanel>
                                <!-- Иконка задачи -->
                                <Border Width="50" 
                                       Height="50" 
                                       Background="#0696d7" 
                                       CornerRadius="25"
                                       Margin="0,0,0,15">
                                    <TextBlock Text="📝" 
                                              FontSize="24" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Foreground="White"/>
                                </Border>
                                
                                <!-- Название задачи -->
                                <TextBlock Text="{Binding Model.Name}" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Foreground="#2C3E50"
                                          Margin="0,0,0,8"/>
                                
                                <!-- Описание -->
                                <TextBlock Text="{Binding Model.Description}" 
                                          FontSize="13" 
                                          Foreground="#7F8C8D"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,15"
                                          MaxHeight="60"/>
                                
                                <Border Height="1" Background="#ECF0F1" Margin="0,0,0,15"/>
                                
                                <!-- Кнопка перехода к доске -->
                                <Button Content="📋 Перейти к доске" 
                                       Height="35"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding DataContext.NavigateToDeskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding Model.DeskId}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource commonBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.DeskId}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Информация о задаче -->
                                <StackPanel>
                                    <!-- Создатель -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Creator.FirstName, TargetNullValue='Не указан'}" 
                                                  FontSize="12" 
                                                  Foreground="#7F8C8D"/>
                                    </StackPanel>
                                    
                                    <!-- Исполнитель -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="🎯" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Executor.FirstName, TargetNullValue='Не указан'}" 
                                                  FontSize="12" 
                                                  Foreground="#7F8C8D"/>
                                    </StackPanel>
                                    
                                    <!-- Даты -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" Background="#E8F4F8" CornerRadius="12" Margin="0,0,8,0">
                                            <TextBlock Text="📅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock FontSize="12" Foreground="#7F8C8D">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy} - {1:dd.MM.yyyy}">
                                                    <Binding Path="Model.StartDate" />
                                                    <Binding Path="Model.EndDate" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
