<Page x:Class="TaskManager.Client.Views.Pages.UserTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TaskManager.Client.Views.Pages"
      mc:Ignorable="d"
      Title="UserTasksPage" Height="450" Width="800">
    <Grid>
        <ListView ItemsSource="{Binding AllTasks}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Path=Model.Id}"></GridViewColumn>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Model.Name}"></GridViewColumn>
                    <GridViewColumn Header="Creator">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Creator.FirstName, TargetNullValue='Не указан'}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Executor">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Executor.FirstName, TargetNullValue='Не указан'}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Start" DisplayMemberBinding="{Binding Path=Model.StartDate}"></GridViewColumn>
                    <GridViewColumn Header="End" DisplayMemberBinding="{Binding Path=Model.EndDate}"></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
